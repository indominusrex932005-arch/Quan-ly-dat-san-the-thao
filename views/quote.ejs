<%- include('partials/header') %>
<h1 class="h3">Xác nhận thông tin</h1>
<div class="card"><div class="card-body">
  <dl class="row">
    <dt class="col-sm-3">Người chơi</dt><dd class="col-sm-9"><%= guest.name %></dd>
    <dt class="col-sm-3">Số điện thoại</dt><dd class="col-sm-9"><%= guest.phone %></dd>
    <dt class="col-sm-3">Sân</dt><dd class="col-sm-9"><%= court.name %> – <%= facility.name %></dd>
    <dt class="col-sm-3">Địa chỉ</dt><dd class="col-sm-9"><%= facility.address %></dd>
    <dt class="col-sm-3">Ngày</dt><dd class="col-sm-9"><%= date %></dd>
    <dt class="col-sm-3">Các ô đã chọn</dt><dd class="col-sm-9"><ul class="mb-0">
      <% for (const slot of quote.slots) { %><li><%= slot.time %>–<%= slot.endTime %>: <%= currency(slot.priceVND) %></li><% } %>
    </ul></dd>
    <dt class="col-sm-3">Thời lượng</dt><dd class="col-sm-9"><%= quote.totalMinutes %> phút</dd>
    <dt class="col-sm-3">Tổng tiền</dt><dd class="col-sm-9 fw-bold"><%= currency(quote.totalPriceVND) %></dd>
  </dl>
  <p class="text-secondary">Bản khởi đầu chỉ báo giá, chưa lưu đơn hoặc giữ chỗ. Trang QR sẽ được nối khi xây xử lý đặt sân và thanh toán.</p>
  <a class="btn btn-outline-secondary" href="/courts/<%= court._id %>?date=<%= date %>">Chọn lại</a>
  <button class="btn btn-primary" disabled>Thanh toán – chưa kết nối</button>
</div></div>
<%- include('partials/footer') %>
