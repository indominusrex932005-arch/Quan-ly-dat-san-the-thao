<%- include('partials/header') %>
<div class="owner-login">
  <header class="owner-login-heading">
    <p class="eyebrow">DÀNH CHO CHỦ SÂN</p>
    <h1 id="owner-login-title">Đăng nhập chủ sân</h1>
    <p>Quản lý sân, gọn một chỗ.</p>
  </header>
  <section class="panel login-card" aria-label="Thông tin đăng nhập" aria-describedby="owner-login-note">
    <p class="login-intro">Một tài khoản cho mỗi cơ sở.</p>
    <p class="demo-note login-note" id="owner-login-note">
      Đăng nhập thật chưa được hỗ trợ.
      <% if (demo) { %>Trang quản lý mẫu bên dưới không yêu cầu đăng nhập hoặc cấp quyền quản lý thật.<% } else { %>Các ô nhập và nút hiện chưa sử dụng được.<% } %>
    </p>
    <label class="form-label" for="owner-email">Email</label>
    <input class="form-control mb-3" id="owner-email" type="email" placeholder="Email chủ sân" autocomplete="username" disabled>
    <label class="form-label" for="owner-password">Mật khẩu</label>
    <input class="form-control mb-4" id="owner-password" type="password" placeholder="Mật khẩu" autocomplete="current-password" disabled>
    <button class="btn btn-primary w-100" type="button" aria-describedby="owner-login-note" disabled>Đăng nhập</button>
    <% if (demo) { %>
      <div class="login-preview">
        <p>Khám phá bố cục quản lý với dữ liệu mẫu.</p>
        <a class="btn btn-outline-secondary w-100" href="/demo/owner">Xem quản lý mẫu <span aria-hidden="true">→</span></a>
      </div>
    <% } %>
  </section>
  <a class="back-link login-back" href="/"><span aria-hidden="true">←</span> Về trang chủ</a>
</div>
<%- include('partials/footer') %>
