<%- include('partials/header') %>
<a href="/facilities/<%= facility._id %>">← Quay lại cơ sở</a>
<h1 class="h3 mt-3"><%= court.name %> – <%= facility.name %></h1><p><%= facility.address %></p>
<form method="get" class="mb-4 d-flex align-items-end gap-2">
  <div><label for="date" class="form-label">Ngày chơi</label><input class="form-control" type="date" id="date" name="date" value="<%= date %>" required></div>
  <button class="btn btn-outline-primary">Xem lịch</button>
</form>
<div class="legend mb-3" aria-label="Chú thích trạng thái">
  <span>⬜ Trống</span><span class="text-primary">● Đã đặt</span><span class="text-warning-emphasis">● Locked</span><span class="selected-label">● Đang chọn</span><span class="text-secondary">● Không phục vụ</span>
</div>
<p>Mỗi ô 30 phút. Có thể chọn các ô rời nhau trong cùng sân và ngày.</p>
<form method="post" action="/quotes" id="booking-form">
  <input type="hidden" name="courtId" value="<%= court._id %>"><input type="hidden" name="date" value="<%= date %>">
  <div class="slot-grid">
    <% for (const slot of slots) { %>
      <label class="slot <%= slot.status.toLowerCase() %>">
        <input type="checkbox" name="times" value="<%= slot.time %>" data-price="<%= slot.priceVND %>" <%= slot.status !== 'AVAILABLE' ? 'disabled' : '' %>>
        <span class="slot-content"><strong><%= slot.time %>–<%= slot.endTime %></strong>
          <small><%= slot.status === 'BOOKED' ? 'Đã đặt' : slot.status === 'LOCKED' ? 'Locked' : slot.status === 'UNAVAILABLE' ? 'Không phục vụ' : currency(slot.priceVND) %></small>
        </span>
      </label>
    <% } %>
  </div>
  <div class="selection-summary mt-3 p-3 border rounded">
    <p id="selection-summary" class="mb-2" aria-live="polite">Chưa chọn ô giờ.</p>
    <button type="button" class="btn btn-primary" id="open-guest" disabled>Đặt sân</button>
  </div>
  <dialog id="guest-dialog" class="guest-dialog">
    <h2 class="h5">Thông tin người chơi</h2>
    <p>Thông tin dùng để liên hệ và check-in tại sân.</p>
    <label for="guest-name" class="form-label">Họ tên</label>
    <input class="form-control mb-3" id="guest-name" name="name" autocomplete="name" minlength="2" maxlength="100" required>
    <label for="guest-phone" class="form-label">Số điện thoại</label>
    <input class="form-control mb-3" id="guest-phone" name="phone" type="tel" autocomplete="tel" maxlength="20" required>
    <button type="button" id="close-guest" class="btn btn-outline-secondary">Quay lại</button>
    <button class="btn btn-primary">Tiếp tục</button>
  </dialog>
</form>
<%- include('partials/footer') %>
