        <span>Đặt sân<span class="brand-subtitle">THỂ THAO</span></span>
      </a>
      <div class="nav-links">
        <a class="nav-find" href="/#co-so">Tìm sân</a>
        <a class="owner-link" href="<%= demo ? '/demo/owner' : '/owner/login' %>"><%= demo ? 'Xem quản lý mẫu' : 'Chủ sân đăng nhập' %><span aria-hidden="true"> →</span></a>
      </div>
    </nav>
  </header>
  <main id="main-content" class="container page-main">
    <div class="demo-note" role="status">
      <span class="demo-dot" aria-hidden="true"></span>
      <span><%= demo ? 'Dữ liệu mẫu · Không giữ sân hoặc nhận tiền thật' : 'Đọc dữ liệu MongoDB · Chức năng đặt sân và thanh toán chưa hoàn thiện' %></span>
    </div>
